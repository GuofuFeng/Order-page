# Supabase Configuration
# Get these from your Supabase project settings → API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT Secret for user authentication
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-min-32-chars"

# Captcha secret for math captcha verification
CAPTCHA_SECRET="your-captcha-secret"

# Cleanup API Token (used by daily cleanup script / cron job)
# Generate: node -e "console.log('cleanup_sk_' + Date.now() + '_' + require('crypto').randomBytes(8).toString('hex'))"
CLEANUP_API_TOKEN="cleanup_sk_your_token_here"

# Optional: Override API URL for cleanup script (defaults to http://localhost:3001)
# In production set this to your Vercel deployment URL
# CLEANUP_API_URL="https://your-domain.vercel.app"
